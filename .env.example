# Copy to .env and fill in your real values. See app/config.py for details.

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
DLQ_QUEUE_NAME=dlq

# Discord or Slack incoming webhook URL for dead-letter alerts. Leave empty
# to disable alerting (jobs still get processed normally either way).
ALERT_WEBHOOK_URL=

# Cloudflare R2 (S3-compatible) media storage. Leave empty until the client
# provides credentials — app/storage.py raises a clear error if used
# without them, and nothing else depends on it yet (not wired into tasks.py).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# X (Twitter) API v2 credentials for app/publishers/twitter.py. X_API_KEY /
# X_API_SECRET are app-level (the OAuth 1.0a consumer key/secret from the X
# Developer Portal) and are always read from here. X_ACCESS_TOKEN /
# X_ACCESS_TOKEN_SECRET are the fallback access token used only for jobs
# with no account_id (single-account mode); for multi-account setups, each
# account's access token lives in the accounts table instead — see
# scripts/add_account.py. Leave empty until the client provides credentials.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
