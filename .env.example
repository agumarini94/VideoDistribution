# Copy to .env and fill in your real values. See app/config.py for details.

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
DLQ_QUEUE_NAME=dlq

# Discord or Slack incoming webhook URL for dead-letter alerts. Leave empty
# to disable alerting (jobs still get processed normally either way).
ALERT_WEBHOOK_URL=

# Cloudflare R2 (S3-compatible) media storage. Leave empty until the client
# provides credentials — app/storage.py raises a clear error if used
# without them, and nothing else depends on it yet (not wired into tasks.py).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# X (Twitter) API v2 credentials for app/publishers/twitter.py. X_API_KEY /
# X_API_SECRET are app-level (the OAuth 1.0a consumer key/secret from the X
# Developer Portal) and are always read from here. X_ACCESS_TOKEN /
# X_ACCESS_TOKEN_SECRET are the fallback access token used only for jobs
# with no account_id (single-account mode); for multi-account setups, each
# account's access token lives in the accounts table instead — see
# scripts/add_account.py. Leave empty until the client provides credentials.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# TikTok Content Posting API credentials for app/publishers/tiktok.py
# (Sandbox mode — see CLAUDE.md Phase 10). App-level only: there is no
# single-account fallback for TikTok, every job needs an Account row
# created via scripts/authorize_tiktok.py --account NAME.
#
# TIKTOK_REDIRECT_URI must exactly match a redirect URI registered for this
# app in the TikTok Developer Portal — but the portal rejects
# localhost/127.0.0.1 outright, so this can NOT be
# http://localhost:.../callback. Instead it's a public HTTPS page (e.g. a
# GitHub Pages "callback.html") that does nothing but forward the callback's
# query string to the local script via JS (location.replace), e.g.:
#   https://<user>.github.io/<repo>/callback.html
# See CLAUDE.md Phase 10 / README for the exact callback.html snippet.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-username.github.io/your-repo/callback.html

# Port scripts/authorize_tiktok.py's local one-shot HTTP server listens on
# (always localhost, path /callback) for the forwarder page above to relay
# the OAuth callback to. Only change this if 8910 is already taken locally
# — and update the forwarder page's target URL (its location.replace call)
# to match.
TIKTOK_LOCAL_CALLBACK_PORT=8910

# TikTok webhook listener (Phase 10b, dashboard/api.py POST /webhooks/tiktok
# and app/webhooks/tiktok.py). Signatures are verified using
# TIKTOK_CLIENT_SECRET above, so no separate secret is needed here.
#
# TIKTOK_WEBHOOK_SKIP_SIGNATURE=1 disables signature verification entirely
# — LOCAL CURL/scripts.simulate_tiktok_webhook TESTING ONLY. The dashboard
# logs a loud warning at startup whenever this is set. Never set it in
# production: it means any POST to /webhooks/tiktok is accepted as if it
# came from TikTok.
TIKTOK_WEBHOOK_SKIP_SIGNATURE=

# How old (in seconds) a webhook's signed timestamp is allowed to be before
# it's rejected as a possible replay. Optional, defaults to 300 (5 min) —
# only set this if you have a specific reason to widen/narrow it.
TIKTOK_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=

# HTTP Basic auth for the dashboard (dashboard/api.py). If BOTH are set,
# every route requires these credentials — API endpoints, the static
# frontend, and /docs/openapi.json — EXCEPT POST /webhooks/tiktok, which
# TikTok's servers must be able to reach unauthenticated (its own
# TikTok-Signature verification is its auth). If either is left empty, the
# dashboard still runs (local dev convenience) but logs a loud "UNPROTECTED"
# warning at startup. Set both before deploying anywhere reachable by
# others.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
